using System;

class Program
{
    static void Main()
    {
        int[] vector = new int[5];

        for (int i = 0; i < vector.Length; i++)
        {
            Console.Write("Ingrese un número: ");
            vector[i] = int.Parse(Console.ReadLine());
        }

        Console.WriteLine("\nContenido del vector:");

        for (int i = 0; i < vector.Length; i++)
        {
            Console.WriteLine(vector[i]);
        }
    }
}
