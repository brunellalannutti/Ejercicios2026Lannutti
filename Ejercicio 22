#include <stdio.h>

int main() {
    int vector[5];
    int suma = 0;
    float promedio;

    for(int i = 0; i < 5; i++) {
        printf("Ingrese un numero: ");
        scanf("%d", &vector[i]);

        suma += vector[i];
    }

    printf("\nElementos del vector:\n");
    for(int i = 0; i < 5; i++) {
        printf("%d\n", vector[i]);
    }

    promedio = (float)suma / 5;

    printf("\nSuma: %d", suma);
    printf("\nPromedio: %.2f", promedio);

    return 0;
}
