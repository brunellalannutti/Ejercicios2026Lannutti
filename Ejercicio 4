#include <stdio.h>

void compararVectores(int v1[], int v2[], int tam);

int main() {
    int vector1[5];
    int vector2[5];

    printf("Ingrese los datos del Vector 1:\n");
    for(int i = 0; i < 5; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%d", &vector1[i]);
    }

    printf("\nIngrese los datos del Vector 2:\n");
    for(int i = 0; i < 5; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%d", &vector2[i]);
    }

    compararVectores(vector1, vector2, 5);

    return 0;
}

void compararVectores(int v1[], int v2[], int tam) {
    int mayor = v1[0];
    int vectorMayor = 1;

    for(int i = 0; i < tam; i++) {
        if(v1[i] > mayor) {
            mayor = v1[i];
            vectorMayor = 1;
        }

        if(v2[i] > mayor) {
            mayor = v2[i];
            vectorMayor = 2;
        }
    }

    printf("\nEl valor mayor es: %d\n", mayor);
    printf("Corresponde al Vector %d\n", vectorMayor);
}
